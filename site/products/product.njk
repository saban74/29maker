---
# 제품 상세 페이지 틀 하나로 content/products/*.md 의 제품마다 한 페이지씩 만듭니다.
# 주소: products/(주소용 이름).html
# 2026-11-06 2차 디자인: 회색 띠(제품명 + 제조사 장비 사진) > 구역 바로가기 > 개요·수치·사양표·특징·사진·자료·관련 제품,
# 오른쪽에 "장비 소개서 PDF 다운로드", ESPEC 카탈로그, 견적문의, 대표전화. (design/concepts5/product-platinous.html)
# 제품 정보 파일에 값이 없는 구역은 화면에서 빠집니다.
pagination:
  data: products
  size: 1
  alias: p
  addAllPagesToCollections: true  # 제품 11개 모두 sitemap.xml 에 들어가게
permalink: "products/{{ p.slug }}.html"
layout: layouts/base.njk
css: products
nav: products
eleventyComputed:
  title: "{{ p.title }} | 제이에스 엔지니어링"
  description: "{{ p.description | safe }}"
---
{% set catInfo = productCategories | findBy("code", p.category) %}
{% set quoteHref = ("contact.html?type=quote&product=" + (p.quote_name | qp)) | rel %}
{% set pdfHref = ("assets/pdf/" + p.slug + ".pdf") | rel %}
{# 회색 띠의 큰 사진: "상세 첫 화면 큰 사진(catalog_image)"이 있으면 그것, 없으면 대표 사진 #}
{% set heroImg = p.catalog_image if (p.catalog_image and p.catalog_image.src) else p.photo %}
{% set heroPack = (not (p.catalog_image and p.catalog_image.src)) and (p.photo_frame == "pack") %}
{% set gal = (p.gallery or []) | withoutSrc(heroImg.src) | withoutSrc(p.photo.src) %}
{# 오른쪽 상자에 보일 ESPEC 공식 카탈로그: 자료 목록에서 https:// 로 시작하는 첫 자료 #}
{% set extDoc = p.docs | firstExternal %}

<!-- 현재 위치 줄 -->
<nav class="crumb" aria-label="현재 위치"><div class="wrap"><a href="{{ 'index.html' | rel }}">홈</a><i></i><a href="{{ 'products/index.html' | rel }}">제품소개</a><i></i><a href="{{ ('products/index.html#cat-' + p.category) | rel }}">{{ catInfo.crumb }}</a><i></i><span>{{ p.name }}</span></div></nav>

<div class="wrap">
  <!-- 1. 첫 화면 회색 띠: 제품명 + 제조사 장비 사진 -->
  <section class="p-hero" aria-labelledby="pdp-title">
    <div class="p-band">
      <div class="p-band-t">
        <h1 id="pdp-title">{{ (p.heading or p.name) | h | safe }}</h1>
        <p class="ko">{{ p.title | h | safe }}</p>
        <p class="sub">{{ p.lead | h | safe }}</p>
{% if p.chip %}
        <div class="badges"><span class="badge">{{ p.chip | h | safe }}</span></div>
{% endif %}
      </div>
      <div class="p-band-i{% if heroPack %} p-band-i--pack{% endif %}"><img src="{{ heroImg.src | rel }}"{% if heroImg.width %} width="{{ heroImg.width }}" height="{{ heroImg.height }}"{% endif %} fetchpriority="high" alt="{{ heroImg.alt }}"></div>
    </div>
{% if p.photo_note %}
    <p class="pn pn--photo">{{ p.photo_note | h | safe }}</p>
{% endif %}
  </section>

  <div class="p-main">
    <div>
      <!-- 2. 구역 바로가기 -->
      <nav class="p-nav" aria-label="구역 바로가기">
        <a href="#overview">장비 개요</a>
{% if p.kpis and p.kpis.length %}<a href="#range">핵심 수치</a>{% endif %}
{% if p.spec_tables and p.spec_tables.length %}<a href="#specs">{{ p.specs_title or '모델별 사양' }}</a>{% endif %}
{% if p.features and p.features.length %}<a href="#features">특징</a>{% endif %}
{% if gal.length %}<a href="#gallery">사진</a>{% endif %}
{% if p.awards and p.awards.length %}<a href="#awards">{{ p.awards_tab or '규격·수상' }}</a>{% endif %}
        <a href="#docs">자료</a>
{% if p.related.length %}<a href="#related">관련 제품</a>{% endif %}
      </nav>

      <!-- 3. 장비 개요: 용도(이런 시험에 씁니다) + 특징 요약 + 어울리는 산업 -->
      <section class="p-sec" id="overview">
        <h2>장비 개요</h2>
        <p class="p-lead">{{ p.lead | h | safe }}</p>
{% if p.uses and p.uses.length %}
        <ul class="uses">
{% for u in p.uses %}
          <li><strong>{{ u.title | h | safe }}</strong>{{ u.text | h | safe }}</li>
{% endfor %}
        </ul>
{% endif %}
{% if p.checks and p.checks.length %}
        <ul class="chk" aria-label="특징 요약">
{% for c in p.checks %}
          <li>{{ c | h | safe }}</li>
{% endfor %}
        </ul>
{% endif %}
{% if p.industries.length %}
        <div class="tags" aria-label="어울리는 산업">{% for code in p.industries %}{% set ind = industries | findBy("code", code) %}<a href="{{ ('solutions/' + code + '.html') | rel }}">{{ ind.label }}</a>{% endfor %}</div>
{% endif %}
        <p class="p-co">제이에스 엔지니어링은 1981년부터 ESPEC 한국 총대리점입니다. 도입 상담, 견적, 설치와 A/S 범위는 문의해 주세요.</p>
      </section>

{% if p.kpis and p.kpis.length %}
      <!-- 4. 핵심 수치 -->
      <section class="p-sec" id="range">
        <h2>{{ p.kpi_title or '핵심 수치' }}</h2>
        <div class="kpis">
{% for k in p.kpis %}
          <div class="kpi"><b>{{ k | kv }}</b><span>{{ k.label | h | safe }}</span>{% if k.detail %}<small>{{ k.detail | h | safe }}</small>{% endif %}</div>
{% endfor %}
        </div>
      </section>
{% endif %}

{% if p.spec_tables and p.spec_tables.length %}
      <!-- 5. 사양표 -->
      <section class="p-sec" id="specs">
        <h2>{{ p.specs_title or '모델별 사양' }}</h2>
{% for t in p.spec_tables %}
{% set hasQuote = t.rows | selectattr("quote") | list | length %}
{% if t.title %}
        <h3 class="stbl-title">{{ t.title | h | safe }}{% if t.small %}<small>{{ t.small | h | safe }}</small>{% endif %}</h3>
{% endif %}
        <div class="tbl-wrap" tabindex="0" role="region" aria-label="{{ t.label or ((t.title or '모델별 사양') + ' 표') }}, 좌우로 밀어서 보기">
          <table class="stbl">
{% if t.columns %}
            <thead><tr>{% for col in t.columns | lines %}<th scope="col">{{ col | h | safe }}</th>{% endfor %}{% if hasQuote %}<th scope="col"><span class="sr">견적</span></th>{% endif %}</tr></thead>
{% endif %}
            <tbody>
{% for r in t.rows %}
              <tr><th scope="row">{{ r.head | h | safe }}{% if r.sub %}<small>{{ r.sub | h | safe }}</small>{% endif %}</th>{% for cell in r.cells | lines %}<td>{{ cell | h | safe }}</td>{% endfor %}{% if hasQuote %}<td>{% if r.quote %}<a class="qlink" href="{{ ('contact.html?type=quote&product=' + (r.quote | qp)) | rel }}">이 모델 견적</a>{% endif %}</td>{% endif %}</tr>
{% endfor %}
            </tbody>
          </table>
        </div>
{% endfor %}
{% if p.spec_more and p.spec_more.title %}
        <div class="spec-more">
          <h3>{{ p.spec_more.title | h | safe }}</h3>
          <p>{{ p.spec_more.text | h | safe }}</p>
          <ul class="names">{% for it in p.spec_more.items %}<li>{{ it | h | safe }}</li>{% endfor %}</ul>
{% if p.spec_more.button %}
          <a class="btn btn--line" href="{{ p.spec_more.button_link | rel }}">{{ p.spec_more.button }}</a>
{% endif %}
        </div>
{% endif %}
{% if p.spec_note %}
        <p class="pn">{{ p.spec_note | h | safe }}</p>
{% endif %}
      </section>
{% endif %}

{% if p.features and p.features.length %}
      <!-- 6. 특징 -->
      <section class="p-sec" id="features">
        <h2>특징</h2>
        <div class="feat">
{% for f in p.features %}
          <div class="feat-i"><b{% if (f.big | length) > 6 %} class="long"{% endif %}>{{ f.big | h | safe }}</b><h3>{{ f.title | h | safe }}</h3><p>{{ f.text | h | safe }}</p></div>
{% endfor %}
        </div>
      </section>
{% endif %}

{% if gal.length %}
      <!-- 7. 사진 (제품 정보 파일의 "사진 갤러리") -->
      <section class="p-sec" id="gallery">
        <h2>모델별 사진</h2>
        <div class="gal">
{% for g in gal %}
          <figure><img src="{{ g.src | rel }}"{% if g.width %} width="{{ g.width }}" height="{{ g.height }}"{% endif %} alt="{{ g.alt }}" loading="lazy">{% if g.label %}<figcaption>{{ g.label | h | safe }}</figcaption>{% endif %}</figure>
{% endfor %}
        </div>
        <p class="pn">사진 출처: ESPEC Corp. 제품 카탈로그 및 공식 웹사이트.</p>
      </section>
{% endif %}

{% if p.awards and p.awards.length %}
      <!-- 8. 규격·수상 -->
      <section class="p-sec" id="awards">
        <h2>{{ p.awards_title or '규격과 수상' }}</h2>
        <ul class="awd">
{% for a in p.awards %}
          <li><b>{{ a.title | h | safe }}</b>{% if a.text %}<span>{{ a.text | h | safe }}</span>{% endif %}</li>
{% endfor %}
        </ul>
      </section>
{% endif %}

      <!-- 9. 자료 -->
      <section class="p-sec" id="docs">
        <h2>자료</h2>
        <div class="docs">
          <a href="{{ pdfHref }}" download><span>장비 소개서 PDF (제이에스 엔지니어링 제작, 한국어)<small>A4 · {{ p.name }}</small></span></a>
{% for d in p.docs %}
{% set external = d.url and (d.url.indexOf('http') == 0) %}
          <a href="{{ d.url | rel }}"{% if external %} target="_blank" rel="noopener"{% endif %}><span>{{ d.title | h | safe }}{% if d.text %}<small>{{ d.text | h | safe }}</small>{% endif %}</span></a>
{% endfor %}
{% if p.docs_request != false %}
          <a href="{{ ('contact.html?type=material&item=' + (p.material_name | qp) + '+자료') | rel }}"><span>자료 요청<small>문의 양식으로 연결됩니다.</small></span></a>
{% endif %}
        </div>
      </section>

{% if p.related.length %}
      <!-- 10. 관련 제품 (제품 정보 파일의 "관련 제품"에서 고른 제품이 자동으로 나옴) -->
      <section class="p-sec" id="related">
        <h2>관련 제품</h2>
        <div class="rel">
{% for r in p.related %}
{% set rp = products | bySlug(r.product) %}
{% if rp %}
{% set rc = rp | cardOf(rp.card_related, r) %}
          <a href="{{ ('products/' + rp.slug + '.html') | rel }}"><div class="pt">{% if rc.images and rc.images.length %}<img src="{{ rc.images[0].src | rel }}" alt="" loading="lazy">{% endif %}</div><p>{{ rc.name | h | safe }}</p></a>
{% endif %}
{% endfor %}
        </div>
      </section>
{% endif %}
    </div>

    <!-- 오른쪽: 장비 소개서 PDF, ESPEC 카탈로그, 견적문의, 대표전화 -->
    <aside class="p-side" aria-label="자료와 문의">
      <a class="dl" href="{{ pdfHref }}" download>
        <span class="dl-top"><span class="dl-ico" aria-hidden="true">PDF</span><strong>장비 소개서 PDF 다운로드</strong></span>
        <span class="dl-meta"><span>{{ p.name }} 한국어 소개서</span><em>PDF · A4</em></span>
      </a>
      <div class="side-box">
{% if extDoc %}
        <a class="l" href="{{ extDoc.url }}" target="_blank" rel="noopener">{{ extDoc.title | h | safe }}</a>
{% if extDoc.text %}<small>{{ extDoc.text | h | safe }}</small>{% endif %}
{% endif %}
        <a class="btn btn--accent" href="{{ quoteHref }}">견적문의</a>
      </div>
      <div class="tel"><small>대표전화</small><b><a href="tel:0255570505">02-557-0505</a></b></div>
    </aside>
  </div>
</div>
